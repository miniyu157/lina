#!/usr/bin/env bash

# shellcheck shell=bash

##
# 在本地数据库中搜索发行版镜像。
##

set -euo pipefail
shopt -s inherit_errexit 2> /dev/null || true

SELF_PATH=$(realpath "${BASH_SOURCE[0]}") SELF="${SELF_PATH##*/}"

usage() {
    cat << EOF
用法: ${LINA_CMD:-$SELF} [选项] [关键字...]

在本地数据库中搜索发行版镜像。
支持大小写不敏感子串匹配，多个关键字为 AND 关系。

示例:
  ${LINA_CMD:-$SELF}                   列出所有发行版
  ${LINA_CMD:-$SELF} ubuntu            搜索包含 "ubuntu" 的发行版
  ${LINA_CMD:-$SELF} debian x86_64     搜索同时包含 "debian" 和 "x86_64" 的发行版
  ${LINA_CMD:-$SELF} 24.04 aarch64     搜索支持 aarch64 架构的 24.04 版本

选项:
  -h, --help        显示此帮助信息
EOF
    exit "${1:-0}"
}

highlight_keywords() {
    local text="$1" kw pattern char lower upper i
    shift
    for kw in "$@"; do
        pattern=""
        for ((i = 0; i < ${#kw}; i++)); do
            char="${kw:i:1}"
            lower="${char,,}"
            upper="${char^^}"
            if [[ $lower == "$upper" ]]; then
                case "$char" in
                    '.' | '*' | '[' | '^' | '$' | '/' | $'\\')
                        pattern+="\\$char"
                        ;;
                    *) pattern+="$char" ;;
                esac
            else
                pattern+="[$lower$upper]"
            fi
        done
        # shellcheck disable=SC2001
        # shellcheck disable=SC2154
        text=$(sed "s/${pattern}/${_rev}&${_off_rev}/g" <<< "$text")
    done
    printf '%s' "$text"
}

print_url() {
    local url="$1"
    # shellcheck disable=SC2154
    printf "    ${_url}\033]8;;%s\033\\%s\033]8;;\033\\${_off}\n" "$url" "$url"
}

print_record() {
    local name="$1" hash="$2" versions="$3" archs="$4" desc="$5" file_url="$6"
    shift 6
    local keywords=("$@")
    local hl_name hl_versions hl_archs hl_desc

    local hash_display=""
    if [[ -n $hash ]]; then
        # shellcheck disable=SC2154
        hash_display="${_faint}  ${hash}${_off}"
    fi

    if ((${#keywords[@]} > 0)); then
        hl_name=$(highlight_keywords "$name" "${keywords[@]}")
        hl_versions=$(highlight_keywords "$versions" "${keywords[@]}")
        hl_archs=$(highlight_keywords "$archs" "${keywords[@]}")
        hl_desc=$(highlight_keywords "$desc" "${keywords[@]}")
    else
        hl_name="$name" hl_versions="$versions" hl_archs="$archs"
        hl_desc="$desc"
    fi

    # shellcheck disable=SC2154
    printf '%b' "${_hl2}${_b}${hl_name}${hash_display}${_off}  ${_hl1}${hl_versions}${_off}  ${_faint}[${hl_archs}]${_off}\n"
    printf '%b' "    ${_faint}${hl_desc}${_off}\n"
    print_url "$file_url"
}

main() {
    [[ ${1:-} == "-h" || ${1:-} == "--help" ]] && usage

    local total
    total=$(jq 'length' "$LINA_DB_FILE" 2> /dev/null) || total=0
    if ((total == 0)); then
        local update_cmd="${LINA_PREFIX:+${LINA_PREFIX} }update"
        printf '%b' "数据库为空。\n" >&2
        printf '%b' "请先运行 ${_hl2}${update_cmd}${_off} 来更新本地索引。\n" >&2
        exit 1
    fi

    local keywords=()
    local keywords_lower=()
    local kw
    for kw in "$@"; do
        keywords+=("$kw")
        keywords_lower+=("${kw,,}")
    done

    local jq_filter
    read -rd '' jq_filter << 'JQEOF' || true
.[] | select(
  . as $e |
  ($ARGS.positional | all(
    . as $kw |
    ($e.name + " " + $e.desc + " " +
     ($e.applet.options.archs | join(" ")) + " " +
     ($e.applet.options.versions | join(" ")))
    | ascii_downcase | contains($kw | ascii_downcase)
  ))
) | [
    .applet.file,
    .name,
    .applet.hash,
    (.applet.options.archs | join(" ")),
    (.applet.options.versions | join(" ")),
    .desc
  ] | join("\t")
JQEOF

    local match_count=0 first=1
    local file_url name archs versions desc

    while IFS=$'\t' read -r file_url name hash archs versions desc; do
        if ((first)); then
            if ((${#keywords[@]} > 0)); then
                printf '%b' "${_faint}搜索: ${keywords[*]}${_off}\n"
            else
                printf '%b' "${_faint}表中有 ${total} 个条目：${_off}\n"
            fi
            first=0
        fi

        print_record "$name" "$hash" "$versions" "$archs" "$desc" "$file_url" "${keywords[@]}"
        ((++match_count))
    done < <(jq -r "$jq_filter" "$LINA_DB_FILE" --args "${keywords_lower[@]}")

    if ((match_count == 0)); then
        printf '%b' "未找到匹配 \"${_hl1}${keywords[*]}${_off}\" 的发行版。\n"
        exit 1
    fi
}

main "$@"
